@model eweb.Web.Models.Home.HomeViewModel

@{
    ViewData["Title"] = "Головна";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Навчальна панель</div>
        <h1>Центр вивчення C#</h1>
        <p>Вивчайте C# від основ і відстежуйте власний прогрес.</p>
    </div>
</div>

<div class="dashboard-grid">
    <div class="dashboard-card">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="metric-label">Відкриті уроки</div>
                <div class="metric-value">@Model.OpenLessons/@Model.TotalLessons</div>
            </div>
            <i class="bi bi-book dashboard-icon"></i>
        </div>
    </div>

    <div class="dashboard-card">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="metric-label">Виконані завдання</div>
                <div class="metric-value">@Model.ExercisesSolved</div>
            </div>
            <i class="bi bi-code-slash dashboard-icon"></i>
        </div>
    </div>

    <div class="dashboard-card">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="metric-label">Отримані зірки</div>
                <div class="metric-value">@Model.StarsEarned/@Model.StarsTotal</div>
            </div>
            <i class="bi bi-star dashboard-icon"></i>
        </div>
    </div>

    <div class="dashboard-card">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="metric-label">Прогрес</div>
                <div class="metric-value">@Model.ProgressPercent%</div>
            </div>
            <i class="bi bi-graph-up-arrow dashboard-icon"></i>
        </div>
    </div>
</div>
