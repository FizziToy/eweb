@model IEnumerable<eweb.Domain.Entities.Exercises.InteractiveExercise>

@{
    ViewData["Title"] = "Адмін вправи";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Адміністрування</div>
        <h1>Інтерактивні вправи</h1>
        <p>Керуйте вправами, статусами публікації та порядком показу.</p>
    </div>

    <a asp-action="CreateFull" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        Створити
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="table-shell">
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Урок</th>
                <th>Назва</th>
                <th>Порядок</th>
                <th>Статус</th>
                <th class="text-end">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ex in Model)
            {
                <tr>
                    <td>@ex.Id</td>
                    <td>@ex.LessonId</td>
                    <td class="fw-semibold">@ex.Title</td>
                    <td>@ex.Order</td>
                    <td>
                        @if (ex.IsPublished)
                        {
                            <span class="status-badge status-success">Опубліковано</span>
                        }
                        else
                        {
                            <span class="status-badge status-muted">Чернетка</span>
                        }
                    </td>
                    <td>
                        <div class="action-row justify-content-end">
                            <a asp-action="Details"
                               asp-route-id="@ex.Id"
                               class="btn btn-sm btn-outline-primary">
                                Переглянути
                            </a>

                            @if (!ex.IsPublished)
                            {
                                <form asp-action="Publish" method="post">
                                    <input type="hidden" name="id" value="@ex.Id" />
                                    <button type="submit" class="btn btn-sm btn-primary">Опублікувати</button>
                                </form>

                                <a asp-action="Edit"
                                   asp-route-id="@ex.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Редагувати
                                </a>

                                <form asp-action="Delete" method="post">
                                    <input type="hidden" name="id" value="@ex.Id" />
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Видалити вправу?')">
                                        Видалити
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Unpublish" method="post">
                                    <input type="hidden" name="id" value="@ex.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        Зняти з публікації
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
