@model IEnumerable<eweb.Domain.Entities.LessonCategory>

@{
    ViewData["Title"] = "Категорії";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Адміністрування</div>
        <h1>Категорії уроків</h1>
        <p>Створюйте та редагуйте теми для структурування уроків.</p>
    </div>
</div>

<div class="content-panel">
    <h4>Додати категорію</h4>

    <form asp-action="Create" method="post" class="row g-2 align-items-end">
        <div class="col-md-8">
            <input name="name" class="form-control" placeholder="Назва категорії" />
        </div>

        <div class="col-md-auto">
            <button type="submit" class="btn btn-primary">
                Додати
            </button>
        </div>
    </form>
</div>

<h4 class="mb-3">Список категорій</h4>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="table-shell">
    <table class="table">
        <thead>
            <tr>
                <th>Назва</th>
                <th class="text-end">Стан</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>
                        <form asp-action="Edit" method="post" class="d-flex gap-2">
                            <input type="hidden" name="id" value="@category.Id" />

                            <input name="name"
                                   value="@category.Name"
                                   class="form-control" />

                            <button type="submit"
                                    class="btn btn-outline-primary btn-sm">
                                Зберегти
                            </button>
                        </form>
                    </td>

                    <td class="text-end">
                        @if (!category.Lessons.Any())
                        {
                            <form asp-action="Delete"
                                  method="post"
                                  onsubmit="return confirm('Видалити категорію?');">

                                <input type="hidden" name="id" value="@category.Id" />

                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm">
                                    Видалити
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="status-badge status-muted">Використовується</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<a asp-controller="Lessons"
   asp-action="Index"
   class="btn btn-outline-secondary mt-3">
    Назад
</a>
