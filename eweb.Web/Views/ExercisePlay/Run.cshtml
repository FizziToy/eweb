@model eweb.Web.Models.ExercisePlay.ExerciseRunViewModel
@using System.Text.Json
@using eweb.Web.Models.ExercisePlay

@{
    ViewData["Title"] = Model.ExerciseTitle;
}

<div class="page-header">
    <div>
        <div class="page-kicker">Практична вправа</div>
        <h1>@Model.ExerciseTitle</h1>
    </div>
</div>

@if (Model.IsFinished)
{
    <div class="content-panel">
        <p class="mb-0 text-muted">Цей запуск вже завершений.</p>
    </div>
}
else
{
    @foreach (var task in Model.Tasks)
    {
        <div class="content-panel run-task">

            <h4 class="mb-3">@task.QuestionText</h4>

            @* MULTIPLE CHOICE *@
            @if (task.Type == "MultipleChoice")
            {
                var data = JsonSerializer.Deserialize<MultipleChoiceData>(
                task.DataJson,
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new MultipleChoiceData();

                <form asp-action="SubmitTask" method="post" class="task-form">
                    <input type="hidden" name="attemptId" value="@Model.AttemptId" />
                    <input type="hidden" name="taskId" value="@task.TaskId" />

                    @if (data.Options != null && data.Options.Count > 0)
                    {
                        @for (int i = 0; i < data.Options.Count; i++)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="selectedIndexes" value="@i" id="task-@task.TaskId-option-@i" />
                                <label class="form-check-label" for="task-@task.TaskId-option-@i">@data.Options[i].Text</label>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-danger">Немає варіантів</p>
                    }

                    <button type="submit" class="check-btn">Перевірити</button>

                    <div class="result mt-2 fw-bold"></div>
                </form>
            }

            @* FILL GAPS *@
            else if (task.Type == "FillGaps")
            {
                var data = JsonSerializer.Deserialize<FillGapsData>(
                task.DataJson,
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new FillGapsData();

                <form asp-action="SubmitTask" method="post" class="task-form">
                    <input type="hidden" name="attemptId" value="@Model.AttemptId" />
                    <input type="hidden" name="taskId" value="@task.TaskId" />

                    @for (int i = 0; i < data.Options.Count; i++)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="selectedIndexes" value="@i" id="task-@task.TaskId-gap-@i" />
                            <label class="form-check-label" for="task-@task.TaskId-gap-@i">@data.Options[i]</label>
                        </div>
                    }

                    <button type="submit" class="check-btn">Перевірити</button>
                    <div class="result"></div>
                </form>
            }

            @* REORDER *@
            else if (task.Type == "Reorder")
            {
                var data = JsonSerializer.Deserialize<ReorderData>(
                task.DataJson,
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new ReorderData();

                <form asp-action="SubmitTask" method="post" class="task-form reorder-form">
                    <input type="hidden" name="attemptId" value="@Model.AttemptId" />
                    <input type="hidden" name="taskId" value="@task.TaskId" />

                    <p class="text-muted">Перетягни у правильному порядку:</p>

                    <ul class="reorder-list">
                        @for (int i = 0; i < data.Items.Count; i++)
                        {
                            <li draggable="true" data-index="@(i + 1)">
                                @data.Items[i]
                            </li>
                        }
                    </ul>

                    <input type="hidden" name="selectedOrder" class="order-input" />

                    <button type="submit" class="check-btn">Перевірити</button>
                    <div class="result"></div>
                </form>
            }

            @* MATCH PAIRS *@
            else if (task.Type == "MatchPairs")
            {
                var data = JsonSerializer.Deserialize<MatchPairsData>(
                task.DataJson,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new MatchPairsData();

                var shuffledRight = data.Pairs
                .Select(x => x.Right)
                .OrderBy(x => Guid.NewGuid())
                .ToList();

                <form asp-action="SubmitTask" method="post" class="task-form match-form">
                    <input type="hidden" name="attemptId" value="@Model.AttemptId" />
                    <input type="hidden" name="taskId" value="@task.TaskId" />
                    <input type="hidden" name="selectedPairs" class="pairs-input" />

                    <div class="match-container">
                        <div class="match-wrapper">

                            <svg class="match-lines"></svg>

                            <div class="match-columns">
                                <!-- LEFT -->
                                <div>
                                    <h5>Ліворуч</h5>
                                    @for (int i = 0; i < data.Pairs.Count; i++)
                                    {
                                        <div class="left-item" data-index="@i">
                                            @data.Pairs[i].Left
                                        </div>
                                    }
                                </div>

                                <!-- RIGHT -->
                                <div>
                                    <h5>Праворуч</h5>
                                    @for (int i = 0; i < shuffledRight.Count; i++)
                                    {
                                        <div class="right-item" data-value="@shuffledRight[i]">
                                            @shuffledRight[i]
                                        </div>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>

                    <button type="submit" class="check-btn">Перевірити</button>
                    <div class="result"></div>
                </form>
            }
        </div>
    }

    <input type="hidden" id="attemptIdGlobal" value="@Model.AttemptId" />

    <button type="button" id="finishBtn" class="btn btn-primary">
        Завершити
    </button>

    <div id="finalResult" class="mt-3"></div>
}
