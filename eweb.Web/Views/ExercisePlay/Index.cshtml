@model List<eweb.Domain.Entities.Exercises.InteractiveExercise>

@{
    ViewData["Title"] = "Вправи";
    var completedIds = ViewBag.CompletedIds as HashSet<int> ?? new HashSet<int>();
    var completed = Model.Count(exercise => completedIds.Contains(exercise.Id));
    var total = Model.Count;
    var pct = total > 0 ? (int)Math.Round(completed * 100.0 / total) : 0;
}

<div class="page-header">
    <div>
        <div class="page-kicker">Практика</div>
        <h1>Вправи</h1>
        <p>Закріплюйте матеріал короткими інтерактивними завданнями.</p>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (!Model.Any())
{
    <div class="content-panel">
        <p class="mb-0 text-muted">Поки що немає доступних вправ.</p>
    </div>
}
else
{
    <div class="lessons-progress-banner">
        <div class="progress-label">Прогрес вправ</div>

        <div class="progress-meta">
            <span>@completed з @total вправ виконано</span>
            <span>@pct%</span>
        </div>

        <div class="lessons-progress-track">
            <div class="lessons-progress-fill" data-pct="@pct" style="width:@pct%"></div>
        </div>
    </div>

    <div class="lessons-grid">
        @foreach (var exercise in Model)
        {
            var isCompleted = completedIds.Contains(exercise.Id);

            <div class="lesson-card">
                <div class="lesson-card-top">
                    @if (isCompleted)
                    {
                        <span class="status-badge status-success">
                            <i class="bi bi-check2-circle"></i>
                            Виконано
                        </span>
                    }
                    else
                    {
                        <span class="status-badge status-muted">Доступно</span>
                    }

                    <span class="lesson-badge status-muted">
                        Вправа
                    </span>
                </div>

                <h3>
                    @exercise.Title
                </h3>

                @if (!string.IsNullOrEmpty(exercise.Description))
                {
                    <p>@exercise.Description</p>
                }

                <div class="lesson-card-footer">
                    <div class="text-muted small">
                        Інтерактивне завдання
                    </div>

                    <form asp-action="Start" method="post" class="lesson-card-actions">
                        <input type="hidden" name="exerciseId" value="@exercise.Id" />

                        <button type="submit" class="btn-card-action btn-card-view">
                            Почати
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}
