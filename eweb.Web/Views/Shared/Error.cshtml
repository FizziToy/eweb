@model ErrorViewModel
@{
    ViewData["Title"] = "Помилка";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Система</div>
        <h1>Сталася помилка</h1>
        <p>Запит не вдалося обробити. Спробуйте повторити дію пізніше.</p>
    </div>
</div>

<div class="content-panel">
    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong>
            <code>@Model.RequestId</code>
        </p>
    }

    <p class="mb-0 text-muted">
        Якщо помилка повторюється, збережіть Request ID і передайте його адміністратору.
    </p>
</div>
