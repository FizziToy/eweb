@using eweb.Domain.Constants
@model eweb.Web.Models.Lessons.LessonDetailsViewModel

@{
    ViewData["Title"] = "Урок";
    bool isAdmin = User.IsInRole(RoleNames.Admin);
}

<div class="page-header">
    <div>
        <div class="page-kicker">Урок №@Model.Number</div>
        <h1>@Model.Title</h1>
        <p>@Model.Description</p>
    </div>
</div>

<div class="content-panel">
    <div class="mb-3">
        @Model.Content
    </div>

    @if (isAdmin)
    {
        <div class="d-flex flex-wrap gap-2 mt-3">
            @if (Model.IsPublished)
            {
                <span class="status-badge status-success">Опубліковано</span>
            }
            else
            {
                <span class="status-badge status-danger">Чернетка</span>
            }
        </div>
    }

    <div class="text-muted small mt-3">
        Створено: @Model.CreatedAt
    </div>
</div>

@if (Model.Questions.Any())
{
    <div class="page-header mt-4">
        <div>
            <div class="page-kicker">Перевірка знань</div>
            <h1 class="page-title">Тест</h1>
            @if (!isAdmin)
            {
                <p>Спроби: @Model.AttemptsCount / 10</p>
            }
        </div>
    </div>

    @if (Model.AttemptsExceeded && !isAdmin)
    {
        <div class="alert alert-danger">
            Ви використали всі 10 спроб тесту.
        </div>
    }
    else
    {
        <form method="post">

            <input type="hidden" asp-for="LessonId" />

            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                <div class="content-panel">

                        <input type="hidden"
                               asp-for="Questions[i].QuestionId" />

                        <h5 class="mb-3">
                            @(i + 1). @Model.Questions[i].QuestionText
                        </h5>

                        @for (int j = 0; j < Model.Questions[i].Answers.Count; j++)
                        {
                            var answer = Model.Questions[i].Answers[j];

                            <div class="form-check">

                                <input type="hidden"
                                       asp-for="Questions[i].Answers[j].AnswerId" />

                                <input class="form-check-input"
                                       asp-for="Questions[i].Answers[j].IsSelected"
                                       type="checkbox" />

                                <label class="form-check-label">

                                    @answer.Text

                                    @if (isAdmin || Model.ShowCorrectAnswers)
                                    {
                                        if (answer.IsSelected)
                                        {
                                            <span class="status-badge status-success ms-2">
                                                Правильна
                                            </span>
                                        }
                                    }

                                </label>

                            </div>
                        }
                </div>
            }

            @if (Model.AttemptsExceeded)
            {
                <button type="submit" class="btn btn-secondary" disabled>
                    Спроби вичерпано
                </button>
            }
            else
            {
                <button type="submit" class="btn btn-primary">
                    Відправити
                </button>
            }

        </form>
    }

    @if (Model.ResultPercent != null)
    {
        <div class="alert alert-info mt-4">
            Ваш результат:
            <strong>@Model.ResultPercent %</strong>
        </div>
    }
}
else
{
    <div class="alert alert-secondary">
        До цього уроку ще немає тесту.
    </div>
}

@if (Model.ShowCorrectAnswersModal)
{
    <button type="button"
            class="btn btn-outline-primary mt-3"
            onclick="document.getElementById('correctAnswersModal').style.display='flex'">
        Переглянути правильні відповіді
    </button>

    <div id="correctAnswersModal"
         class="app-modal-backdrop">

        <div class="app-modal">

            <h4>Правильні відповіді</h4>

            @foreach (var q in Model.Questions)
            {
                <p><strong>@q.QuestionText</strong></p>

                <ul>
                    @foreach (var a in q.Answers.Where(a => a.IsSelected))
                    {
                        <li>@a.Text</li>
                    }
                </ul>
            }

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="document.getElementById('correctAnswersModal').style.display='none'">
                Закрити
            </button>

        </div>
    </div>
}

<a asp-action="Index" class="btn btn-outline-secondary mt-4">
    Назад до списку уроків
</a>
