@model eweb.Domain.Entities.Lesson

@{
    ViewData["Title"] = "Видалити урок";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Адміністрування</div>
        <h1>Видалити урок</h1>
        <p>Перевірте дані уроку перед остаточним видаленням.</p>
    </div>
</div>

<div class="content-panel">
    <div class="alert alert-warning">
        Цю дію не можна скасувати.
    </div>

    <dl class="row mb-4">
        <dt class="col-sm-3">Номер</dt>
        <dd class="col-sm-9">@Model.Number</dd>

        <dt class="col-sm-3">Назва</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Опис</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Статус</dt>
        <dd class="col-sm-9">
            @if (Model.IsPublished)
            {
                <span class="status-badge status-success">Опубліковано</span>
            }
            else
            {
                <span class="status-badge status-muted">Чернетка</span>
            }
        </dd>

        <dt class="col-sm-3">Створено</dt>
        <dd class="col-sm-9">@Model.CreatedAt</dd>
    </dl>

    <form asp-action="Delete" method="post" class="action-row">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Видалити</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
    </form>
</div>
