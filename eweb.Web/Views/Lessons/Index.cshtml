@using eweb.Domain.Constants
@model IEnumerable<eweb.Domain.Entities.Lesson>

@{
    ViewData["Title"] = "Уроки";
    bool isAdmin = User.IsInRole(RoleNames.Admin);
    var lessons = Model.ToList();

    var openedLessons = ViewBag.OpenedLessons as List<int> ?? new List<int>();

    int completed = Math.Min(openedLessons.Count, lessons.Count);
    int total = lessons.Count;
    int pct = total > 0 ? (int)Math.Round(completed * 100.0 / total) : 0;
    pct = Math.Min(pct, 100);
}

<div class="lessons-page">

    <!-- Header -->
    <div class="lessons-header">
        <h1>C# Уроки</h1>
        <p>Вивчайте програмування на C# крок за кроком</p>
    </div>

    <!-- Admin toolbar -->
    @if (isAdmin)
    {
        <div class="lessons-toolbar">
            <a asp-action="Create" class="btn-lessons-primary">
                + Створити урок
            </a>

            <a asp-controller="Categories" asp-action="Index" class="btn-lessons-outline">
                Категорії
            </a>
        </div>
    }

    <!-- Progress -->
    <div class="lessons-progress-banner">
        <div class="progress-label">Ваш прогрес</div>

        <div class="progress-meta">
            <span>@completed з @total уроків відкрито</span>
            <span>@pct%</span>
        </div>

        <div class="lessons-progress-track">
            <div class="lessons-progress-fill" data-pct="@pct" style="width:0%"></div>
        </div>
    </div>

    <!-- Cards -->
    <div class="lessons-grid">
        @for (int i = 0; i < lessons.Count; i++)
        {
            var lesson = lessons[i];
            bool done = openedLessons.Contains(lesson.Id);
            bool locked = false;

            if (!isAdmin)
            {
                locked = i != 0 && !openedLessons.Contains(lesson.Id);
            }

            <div class="lesson-card @(locked ? "is-locked" : "")">

                <!-- Top -->
                <div class="lesson-card-top">

                    <div>
                        @if (locked)
                        {
                            <span>🔒</span>
                        }
                        else if (done)
                        {
                            <span>✅</span>
                        }
                        else
                        {
                            <span>⭕</span>
                        }
                    </div>

                    @if (isAdmin)
                    {
                        if (lesson.IsPublished)
                        {
                            <span class="badge bg-success">Опубліковано</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Чернетка</span>
                        }
                    }
                    else if (lesson.Category != null)
                    {
                        <span class="badge bg-light text-dark">
                            @lesson.Category.Name
                        </span>
                    }
                </div>

                <!-- Title -->
                <h3>
                    @(isAdmin? lesson.Number + ". " : (i + 1) + ". ")
                    @lesson.Title
                </h3>

                @if (!string.IsNullOrWhiteSpace(lesson.Description))
                {
                    <p>@lesson.Description</p>
                }

                <!-- Footer -->
                <div class="lesson-card-footer">

                    <div>
                        @if (isAdmin)
                        {
                            @lesson.CreatedAt.ToString("dd.MM.yyyy")
                        }
                        else
                        {
                            @lesson.Category?.Name
                        }
                    </div>

                    @if (!locked)
                    {
                        <div>
                            <a asp-action="Details" asp-route-id="@lesson.Id"
                               class="btn btn-sm btn-outline-primary">
                                Переглянути
                            </a>

                            @if (isAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@lesson.Id"
                                   class="btn btn-sm btn-outline-warning">
                                    Редагувати
                                </a>

                                <a asp-action="Delete" asp-route-id="@lesson.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Видалити
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <span>Виконайте попередні уроки</span>
                    }

                </div>
            </div>
        }
    </div>

</div>