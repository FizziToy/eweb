@page
@model LoginModel

@{
    ViewData["Title"] = "Вхід";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Акаунт</div>
        <h1>Вхід</h1>
        <p>Увійдіть, щоб продовжити навчання.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <section class="content-panel">
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password">Пароль</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe" class="form-check-label">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">
                    Увійти
                </button>

                <div class="mt-3 d-grid gap-1">
                    <a id="forgot-password" asp-page="./ForgotPassword">Забули пароль?</a>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Створити акаунт</a>
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Повторно надіслати підтвердження</a>
                </div>
            </form>
        </section>
    </div>

    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
    {
        <div class="col-lg-5">
            <section class="content-panel">
                <h3>Інші способи входу</h3>
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div class="action-row">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit"
                                    class="btn btn-outline-primary"
                                    name="provider"
                                    value="@provider.Name"
                                    title="Увійти через @provider.DisplayName">
                                @provider.DisplayName
                            </button>
                        }
                    </div>
                </form>
            </section>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
